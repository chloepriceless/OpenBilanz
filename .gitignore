# Lokale Daten (Buchhaltung) - bei Bedarf separat sichern/versionieren.
# Enthaelt Steuerdaten - bewusst NICHT im Repository. Zum Versionieren der
# eigenen Buchfuehrung mit Git diese Zeile entfernen.
data/

# E-Bilanz-Taxonomie (~53 MB, amtlich) - per tools/setup-taxonomie.sh laden
taxonomie/*.zip
taxonomie/german-gaap*/

# Website-Modus: gross gehostete Laufzeit-Assets - nicht im Repo
public/taxonomie/
public/pyodide/
public/wheels/

# Drittquellen fuer ZUGFeRD-PDF-Erzeugung - per tools/setup-pdf-lib.sh laden
public/vendor/

# Selbstsigniertes Entwickler-Zertifikat fuer tools/serve-website.py
tools/.devcert/

# Deployment-spezifische Rechts-Links (Impressum/Datenschutz) - nur fuer
# oeffentlich gehostete Instanzen. Vorlage: public/rechtliche-links.beispiel.json
public/rechtliche-links.json

# Sonstiges
node_modules/
*.log
.DS_Store
__pycache__/
HANDOFF.md
PLAN.md
test-backup/
.planning/inbox/
.planning/archive/
